<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="AeroTestX Regression Suite" parallel="classes"
       thread-count="5">

    <test name="UI Regression Tests">

        <classes>

            <!-- UI -->
            <class name="com.aerotestx.tests.FlightSearchTest"/>

            <class name="com.aerotestx.tests.BookingTest"/>
            
            <class name="com.aerotestx.tests.SearchCheapestFlights"/>

            <!-- API -->
            <class name="com.aerotestx.api.UserApiTesting"/>
            <class name="com.aerotestx.api.UserCrudTest"/>

            <!-- Database -->
            <class name="com.aerotestx.database.DatabaseTest"/>
        </classes>    

    </test>

</suite>